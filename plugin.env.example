# Knowledge Base Plugin — configuration
# Copy this file to plugin.env and adjust as needed.
#
# These settings control WHEN and HOW MUCH knowledge is injected into an
# agent. Two moments inject knowledge:
#
#   1. Task start      — a task gets KNOWLEDGE_TASK_CHUNKS chunks before
#                        the worker begins (overridable per task with
#                        `knowledge_chunks`).
#   2. Mid-run         — every KNOWLEDGE_INJECT_AFTER_TOOLS tool calls the
#                        running agent receives another block.
#
# Precedence: process environment > plugin.env > plugin.env.example > default.
# A malformed value logs a warning and falls back to the default; it never
# breaks a run.
#

# ── Mid-run injection ────────────────────────────────────────────────────────
#
# Inject a knowledge block after this many COMPLETED tool calls.
# Counting starts at the first LLM call of a run; the counter restarts after
# every injection, so blocks come in fixed windows.
#   KNOWLEDGE_INJECT_AFTER_TOOLS=13   # default: every 13 tool calls
#   KNOWLEDGE_INJECT_AFTER_TOOLS=5    # more eager
#   KNOWLEDGE_INJECT_AFTER_TOOLS=0    # disable mid-run injection entirely
KNOWLEDGE_INJECT_AFTER_TOOLS=13

# How many chunks one mid-run block carries.
# Each chunk is rendered with ONE invitation line for deeper reading.
KNOWLEDGE_INJECT_CHUNKS=3

# Safety cap: how often the mid-run hook may fire for ONE agent run.
# Guards a long tool loop against drowning the context in injections.
KNOWLEDGE_INJECT_MAX_PER_RUN=6

# ── Task start ───────────────────────────────────────────────────────────────
#
# How many chunks a task receives when it starts (cold injection).
# A task may override this with its own `knowledge_chunks` field; the planner
# sets that per task when a task needs more or no literature at all.
KNOWLEDGE_TASK_CHUNKS=3

# ── Retrieval filter ─────────────────────────────────────────────────────────
#
# Minimum retrieval score for a chunk to be injected. Chunks below this are
# dropped rather than wasting context on loosely related material.
KNOWLEDGE_INJECT_MIN_SCORE=0.35

# Token ceiling for ONE injection block (rough estimate, 4 chars ≈ 1 token).
# Chunks are added until the ceiling is reached.
KNOWLEDGE_INJECT_BUDGET_TOKENS=900

# ── Master switch ────────────────────────────────────────────────────────────
#
# true = no knowledge discovery at all: no node, no injection, no corpus
# search. Useful for offline runs and tests.
DISABLE_KNOWLEDGE_DISCOVERY=false

# ── Enable by default ───────────────────────────────────────────────────────
#
# When true, knowledge discovery runs for EVERY task unless the task explicitly
# sets requires_knowledge_discovery: false. When false (default), the planner
# decides per task and must set requires_knowledge_discovery: true.
#   ENABLE_KNOWLEDGE_DISCOVERY_DEFAULT=true   # always run discovery
#   ENABLE_KNOWLEDGE_DISCOVERY_DEFAULT=false  # planner decides (default)
ENABLE_KNOWLEDGE_DISCOVERY_DEFAULT=false

# ── State (agent assignments and access grants) ─────────────────────────────
#
# The store is SQLite. It MUST NOT live inside the repo: inside the container
# the repo is a read-only bind and SQLite answers
# "attempt to write a readonly database".
#
# Resolution order (first writable wins) — see state_paths.py:
#   1. KNOWLEDGE_DB_PATH (when its directory is writable)
#   2. PENTA_STATE_DIR
#   3. <repo>/db               ← a rw bind in the compose stack
#   4. ~/.penta/knowledge-base
#
# KNOWLEDGE_DB_PATH=/srv/penta-state/knowledge_base.db
# PENTA_STATE_DIR=/srv/penta-state
